{
 "uid": "ripe-pipeline",
 "title": "RIPE Atlas Pipeline",
 "tags": [
  "ripe-atlas"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Độ tươi Gold theo measurement (giây kể từ event mới nhất)",
   "description": "SLO đề xuất: ≤ 7200 s (2 giờ).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max by (measurement_id) (ripe_gold_max_event_timestamp_seconds{run_type=~\"$run_type\"})",
     "legendFormat": "{{measurement_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5400
       },
       {
        "color": "red",
        "value": 7200
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Lần thành công gần nhất theo stage (giây trước)",
   "description": "Lịch chạy theo giờ: > 1 giờ 5 phút là trễ một lần.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max by (stage) (ripe_job_last_success_timestamp_seconds{run_type=~\"$run_type\"})",
     "legendFormat": "{{stage}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 3900
       },
       {
        "color": "red",
        "value": 7200
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Lần chạy gần nhất thành công? (1/0)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (stage, run_type) (ripe_job_last_run_success{run_type=~\"$run_type\"})",
     "legendFormat": "{{stage}} {{run_type}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "bargauge",
   "title": "Thời lượng job lần gần nhất",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (stage) (ripe_job_duration_seconds{run_type=~\"$run_type\"})",
     "legendFormat": "{{stage}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "bargauge",
   "title": "Request RIPE Atlas API theo kết quả (lần chạy gần nhất)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (endpoint, status_class) (ripe_api_requests{run_type=~\"$run_type\"})",
     "legendFormat": "{{endpoint}} {{status_class}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "bargauge",
   "title": "Retry theo lý do (429 / 5xx / mạng)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (endpoint, reason) (ripe_api_retries{run_type=~\"$run_type\"})",
     "legendFormat": "{{endpoint}} {{reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Thời gian trung bình mỗi request",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (endpoint) (ripe_api_request_duration_seconds_total{run_type=~\"$run_type\"}) / sum by (endpoint) (ripe_api_request_count_total{run_type=~\"$run_type\"})",
     "legendFormat": "{{endpoint}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "bargauge",
   "title": "Result ingest theo loại (lần chạy gần nhất)",
   "description": "unchanged = trùng nội dung khi tải chồng lấn (không stage lại).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (ripe_ingest_records{kind=~\"fetched|staged|unchanged|changed|status_malformed_json\", run_type=~\"$run_type\"})",
     "legendFormat": "{{kind}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "bargauge",
   "title": "Bronze: dòng theo loại",
   "description": "already_present = xử lý lại; quarantined = bị cách ly.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (entity, kind) (ripe_bronze_rows{run_type=~\"$run_type\"})",
     "legendFormat": "{{entity}} {{kind}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "stat",
   "title": "Kiểm tra chất lượng thất bại",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (layer, severity) (ripe_dq_failed_checks{run_type=~\"$run_type\"})",
     "legendFormat": "{{layer}} {{severity}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "bargauge",
   "title": "Độ đầy đủ ước tính giờ gần nhất",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (probe_set_version, measurement_id) (ripe_gold_latest_hour_completeness_ratio{run_type=~\"$run_type\"})",
     "legendFormat": "{{probe_set_version}} {{measurement_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 0.9
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "bargauge",
   "title": "Silver: số dòng theo measurement (ngày vừa tính lại)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (measurement_id) (ripe_silver_rows{run_type=~\"$run_type\"})",
     "legendFormat": "{{measurement_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "stat",
   "title": "Service health (up)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min by (job) (up)",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "stat",
   "title": "Đĩa dữ liệu Docker đã dùng",
   "description": "Giới hạn thật là ổ D: của host; ngưỡng đề xuất 50 GB.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 40,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(node_filesystem_size_bytes{mountpoint=\"/mnt/docker-desktop-disk\"} - node_filesystem_free_bytes{mountpoint=\"/mnt/docker-desktop-disk\"})",
     "legendFormat": "used",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 40000000000.0
       },
       {
        "color": "red",
        "value": 50000000000.0
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 15,
   "type": "stat",
   "title": "RAM VM Docker đang dùng",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 40,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "legendFormat": "mem",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "CPU VM Docker",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
     "legendFormat": "cpu busy",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Trino: thời gian thực thi truy vấn (5 phút gần nhất)",
   "description": "Độ trễ truy vấn do Superset / SQL client gửi tới Trino.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 48,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "trino_execution_name_QueryManager_ExecutionTime_FiveMinutes{quantile=\"0.5\"} / 1000",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "trino_execution_name_QueryManager_ExecutionTime_FiveMinutes{quantile=\"0.95\"} / 1000",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Trino: truy vấn đang chạy / thất bại",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 48,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "trino_execution_name_QueryManager_RunningQueries",
     "legendFormat": "running",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "increase(trino_execution_name_QueryManager_FailedQueries_TotalCount[15m])",
     "legendFormat": "failed (15m)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ],
 "templating": {
  "list": [
   {
    "name": "run_type",
    "label": "Loại lần chạy",
    "type": "custom",
    "query": "scheduled,reconcile,backfill,repair,manual",
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "scheduled"
     ],
     "value": [
      "scheduled"
     ]
    },
    "options": [
     {
      "selected": true,
      "text": "scheduled",
      "value": "scheduled"
     },
     {
      "selected": false,
      "text": "reconcile",
      "value": "reconcile"
     },
     {
      "selected": false,
      "text": "backfill",
      "value": "backfill"
     },
     {
      "selected": false,
      "text": "repair",
      "value": "repair"
     },
     {
      "selected": false,
      "text": "manual",
      "value": "manual"
     }
    ],
    "description": "Số liệu job theo loại lần chạy. Cảnh báo chỉ xét scheduled."
   }
  ]
 },
 "description": "Vận hành pipeline: độ tươi, job, API, khối lượng, chất lượng, hạ tầng. Runbook: docs/runbook.md"
}
