# Sao chép thành .env và thay mọi giá trị "change-me". Không commit .env.

# SeaweedFS S3 - quản trị và tạo bucket
S3_ADMIN_ACCESS_KEY=change-me-admin-key
S3_ADMIN_SECRET_KEY=change-me-admin-secret

# SeaweedFS S3 - dlt ghi vào staging
S3_INGEST_ACCESS_KEY=change-me-ingest-key
S3_INGEST_SECRET_KEY=change-me-ingest-secret

# SeaweedFS S3 - Spark đọc staging, ghi warehouse
S3_PROCESSING_ACCESS_KEY=change-me-processing-key
S3_PROCESSING_SECRET_KEY=change-me-processing-secret

# SeaweedFS S3 - Trino chỉ đọc warehouse
S3_SERVING_ACCESS_KEY=change-me-serving-key
S3_SERVING_SECRET_KEY=change-me-serving-secret

# PostgreSQL - metadata của Nessie
NESSIE_POSTGRES_PASSWORD=change-me

# Superset (profile analytics)
SUPERSET_SECRET_KEY=change-me-long-random-string
SUPERSET_DB_PASSWORD=change-me
SUPERSET_ADMIN_PASSWORD=change-me
